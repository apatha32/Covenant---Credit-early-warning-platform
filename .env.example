# Copy to .env and fill in. Never commit .env.

# --- Runtime ---
TRIPWIRE_ENV=dev                # dev | ci | prod
TRIPWIRE_DOMAIN_PACK=finance    # folder under config/domain/
LOG_LEVEL=INFO

# --- Storage (raw Parquet, model artifacts) ---
TRIPWIRE_STORAGE=local         # local | supabase (private bucket SUPABASE_STORAGE_BUCKET)
TRIPWIRE_DATA_DIR=./data        # local backend root; git-ignored

# --- SEC EDGAR ---
# Required on every SEC request. Must contain a contact email or SEC may block the IP.
SEC_USER_AGENT="Covenant Research you@example.com"

# --- FRED --- free key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# --- Anthropic (Claude API) ---
ANTHROPIC_API_KEY=

# --- Supabase ---
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=     # server side only: never in apps/web or Vercel
SUPABASE_STORAGE_BUCKET=tripwire
# Postgres connection used by Python services and migrations. For Supabase cloud use the
# Session pooler string (IPv4; GitHub Actions has no IPv6), port 5432.
DATABASE_URL=postgresql://postgres:postgres@localhost:54329/postgres

# --- Tests ---
# Server where the test suite creates (and drops) throwaway databases.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:54329/postgres
# Set to 1 to make DB tests fail instead of skip when no server is reachable (CI does this).
REQUIRE_DB=0
